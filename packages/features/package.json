{
  "name": "@dsh-cursorkit/features",
  "version": "0.1.0",
  "description": "Page-level feature containers: sessions / chat / trajectory / changes / settings (connect store with ui-kit)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "echo \"features: no lint rules yet\""
  },
  "dependencies": {
    "@dsh-cursorkit/client": "workspace:*",
    "@dsh-cursorkit/protocol": "workspace:*",
    "@dsh-cursorkit/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
