{
  // NOTE: `paths` maps @dsh-cursorkit/protocol to its source so this package
  // typechecks against the real domain/event types. The protocol package's
  // published types (lib/types/index.d.ts) are not emitted by its current
  // build, so plain package resolution would fail. Emit still keeps the bare
  // specifier "@dsh-cursorkit/protocol", so runtime resolution is unaffected.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    // base tsconfig has no `jsx` — required for .tsx sources.
    "jsx": "react-jsx",
    // declarationDir is resolved relative to this tsconfig, so .d.ts files
    // land in lib/types/ while JS goes to lib/ (matches package.json types).
    "declarationDir": "lib/types",
    "paths": {
      "@dsh-cursorkit/protocol": ["../protocol/src/index.ts"]
    }
  },
  "include": ["src"]
}
