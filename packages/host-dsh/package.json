{
  "name": "@dsh-cursorkit/host-dsh",
  "version": "0.1.0",
  "description": "dsh plugin: in-process HTTP+SSE RPC server exposing the CKP protocol (the only package allowed to touch ctx.*)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "echo \"host-dsh: no lint rules yet\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-cursorkit/protocol": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
