{
  "name": "dsh-cursorkit",
  "displayName": "DSH CursorKit",
  "description": "Cursor 同款 AI IDE：以 dsh 为 agent 内核的 AI 编程助手（Chat / Agent / Tab 补全 / Ctrl+K / Checkpoint）",
  "version": "0.1.0",
  "publisher": "sprogx",
  "license": "MIT",
  "private": true,
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprog-xhy/dsh-cursorkit.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dshCursorkit.newChat",
        "title": "DSH CursorKit: New Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dshCursorkit.openChat",
        "title": "DSH CursorKit: Open Chat"
      },
      {
        "command": "dshCursorkit.stop",
        "title": "DSH CursorKit: Stop"
      },
      {
        "command": "dshCursorkit.editCode",
        "title": "DSH CursorKit: Edit Code (Ctrl+K)",
        "icon": "$(pencil)"
      },
      {
        "command": "dshCursorkit.toggleTab",
        "title": "DSH CursorKit: Toggle Tab Completion"
      },
      {
        "command": "dshCursorkit.openSettings",
        "title": "DSH CursorKit: Settings"
      },
      {
        "command": "dshCursorkit.checkpoints",
        "title": "DSH CursorKit: Checkpoints (时间线)"
      },
      {
        "command": "dshCursorkit.focusChatView",
        "title": "DSH CursorKit: 在侧边栏打开 Chat"
      },
      {
        "command": "dshCursorkit.doctor",
        "title": "DSH CursorKit: 自检 / 诊断",
        "icon": "$(pulse)"
      }
    ],
    "keybindings": [
      {
        "command": "dshCursorkit.openChat",
        "key": "ctrl+alt+c",
        "when": "!chatInputFocused"
      },
      {
        "command": "dshCursorkit.editCode",
        "key": "ctrl+k",
        "when": "editorHasSelection && editorTextFocus && !suggestWidgetVisible && !inDebugRepl"
      },
      {
        "command": "dshCursorkit.toggleTab",
        "key": "ctrl+alt+t",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshCursorkit",
          "title": "DSH CursorKit",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "dshCursorkit": [
        {
          "id": "dshCursorkit.chatView",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "dshCursorkit.sessions",
          "name": "Sessions",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "DSH CursorKit",
      "properties": {
        "dshCursorkit.sidecar.dshHome": {
          "type": "string",
          "default": "",
          "description": "dsh 数据目录（DSH_HOME）。留空 = ~/.dsh-cursorkit"
        },
        "dshCursorkit.sidecar.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "激活时自动启动 sidecar"
        },
        "dshCursorkit.chat.defaultModel": {
          "type": "string",
          "default": "wps/moonshot/kimi-k2.7-code",
          "description": "默认模型（provider/model）"
        },
        "dshCursorkit.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Tab 补全"
        },
        "dshCursorkit.tab.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "Tab 补全触发防抖（毫秒）"
        },
        "dshCursorkit.permission.mode": {
          "type": "string",
          "enum": [
            "danger-full-access",
            "workspace-write",
            "default"
          ],
          "default": "danger-full-access",
          "description": "dsh 权限模式（Cursor 风格：默认自动执行）"
        },
        "dshCursorkit.sidecar.hostDshPath": {
          "type": "string",
          "default": "",
          "description": "自定义 host-dsh 包目录（留空则自动：开发仓库 packages/ 或扩展内置 bundled/）"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "dshCursorkit.sessions",
        "contents": "DSH CursorKit 已就绪。\n[打开 Chat 面板](command:dshCursorkit.openChat)\n[新建会话](command:dshCursorkit.newChat)\n[自检（诊断环境）](command:dshCursorkit.doctor)\n需要本机安装 dsh（0.1.1-rc.2）与 LLM 凭据。"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/bundle-deps.mjs && vsce package --no-dependencies",
    "bundle:deps": "node scripts/bundle-deps.mjs"
  },
  "devDependencies": {
    "@dsh-cursorkit/client": "workspace:*",
    "@dsh-cursorkit/protocol": "workspace:*",
    "@types/vscode": "^1.95.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vscode/vsce": "^3.2.1"
  }
}
